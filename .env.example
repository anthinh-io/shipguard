PROJECT_NAME="ShipGuard: Delivery Performance Intelligence"

# Tài khoản và tên cơ sở dữ liệu Postgres mà Docker Compose tạo ở lần chạy đầu.
POSTGRES_USER=replace-with-postgres-username
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=shipguard
POSTGRES_PORT=5432

# Chuỗi kết nối cho ứng dụng và Alembic; ghi postgresql:// thuần, mã tự thêm +asyncpg.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}_test

# Origin của frontend được phép gọi backend, phân tách bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Khóa ký access token (JWT, HS256). Sinh bằng:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Super Admin chỉ được tạo ở lần khởi động đầu tiên, khi chưa có Super Admin nào.
# Sau đó các giá trị này bị bỏ qua; quên mật khẩu thì chạy
#   uv run python -m app.scripts.reset_super_admin_password
SUPER_ADMIN_EMAIL=admin@shipguard.local
SUPER_ADMIN_PASSWORD=replace-with-at-least-8-characters
SUPER_ADMIN_NAME=Super Admin

# Nơi lệnh huấn luyện ghi tệp mô hình và báo cáo đánh giá; backend đọc lại từ đây.
# Chưa huấn luyện thì backend vẫn khởi động bình thường, chỉ thao tác cần dự đoán
# mới báo lỗi. Đường dẫn tương đối tính từ gốc repo, không phải từ thư mục đang đứng.
RISK_MODEL_DIR=./models

# Mức Late Probability từ đó một đơn là High Risk, lớn hơn 0 và nhỏ hơn 1.
# Lấy con số "Ngưỡng đề xuất" mà báo cáo in ra sau khi chạy:
#   uv run python -m app.scripts.train_risk_model
RISK_THRESHOLD=0.15
